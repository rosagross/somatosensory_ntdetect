summarise(
mean_amplitude = mean(amplitude, na.rm = TRUE),
se_amplitude   = sd(amplitude, na.rm = TRUE) / sqrt(n())
)
stats_summary_elec <- df_clean %>%
filter(modality=="Electrical") %>%
group_by(intensity_num, response_decoded) %>%
summarise(
mean_amplitude = mean(amplitude, na.rm = TRUE),
se_amplitude   = sd(amplitude, na.rm = TRUE) / sqrt(n())
)
ggplot(data=df_clean, aes(x=response_decoded, y=amplitude)) +
#  geom_smooth(method='gam') +
geom_boxplot()
ggplot(data=df_clean, aes(x=intensity_norm, y=amplitude)) +
#  geom_smooth(method='gam') +
geom_point()
# center the data
df_pca <- df_clean
X_pca <- df_pca[, c("intensity_norm", "response_bin")]
X_scaled <- scale(X_pca, center = TRUE, scale = TRUE)
pc <- prcomp(X_scaled,
center = FALSE,
scale. = FALSE)
attributes(pc)
print(pc$rotation) # loadings (contribution of the components)
PC_scores <- as.data.frame(pc$x)
# regression
model_pc <- lm(df_pca$amplitude ~ PC1 + PC2, data = PC_scores)
summary(model_pc)
# backtransform PCs
a <- coef(model_pc)[c("PC1", "PC2")]
a0 <- coef(model_pc)[1]
loadings <- pc$rotation
scales <- attr(X_scaled, "scaled:scale")
centers <- attr(X_scaled, "scaled:center")
beta_std <- as.vector(loadings %*% a)      # standardized originals
beta_orig <- beta_std / scales             # original units
intercept_orig <- a0 - sum(beta_orig * centers)
beta_df <- data.frame(
term = c("(Intercept)", "intensity_norm", "response_bin"),
estimate = c(intercept_orig, beta_orig)
)
coef_df_pca <- beta_df
coef_df_pca$model <- "GLM (PCA-orthogonalized)"
# compare with fit without PCA decomposition
glm_orig <- lm(amplitude ~ intensity_norm + response_bin, data = df_pca)
summary(glm_orig)
coef_orig <- coef(glm_orig)
coef_df_orig <- data.frame(
term = names(coef_orig),
estimate = as.numeric(coef_orig),
model = "GLM (no PCA)"
)
# compare fit with and without PCA decomposition
coef_compare <- rbind(coef_df_orig, coef_df_pca)
print(coef_compare)
arrow_scale <- 2
load_df <- as.data.frame(loadings)
load_df$var <- rownames(load_df)
ggplot(PC_scores, aes(x = PC1, y = PC2)) +
geom_point(alpha = 0.5) +
geom_segment(data = load_df,
aes(x = 0, y = 0, xend = PC1 * arrow_scale, yend = PC2 * arrow_scale),
arrow = arrow(length = unit(0.02, "npc")), color = "red") +
geom_text(data = load_df,
aes(x = PC1 * arrow_scale * 1.1, y = PC2 * arrow_scale * 1.1, label = var),
color = "red") +
theme_minimal() +
labs(title = "PCA biplot of predictors",
subtitle = "Arrows = loadings of original variables")
# plot the effect of intensity on the amplitude to check if there is an obvious non-linear trend
ggplot(df_clean, aes(x = intensity_norm, y = amplitude, color = response_decoded)) +
geom_point(alpha = 0.3) +
geom_smooth(method = "loess", se = TRUE) +
labs(
title = "Amplitude vs Intensity by Response",
x = "Normalized Intensity",
y = "Amplitude"
) +
theme_minimal()
df_singlechan <- df_clean
df_singlechan$intensity_level <- as.numeric(as.character(df_singlechan$intensity_level))
df_singlechan$intensity_c <- scale(df_singlechan$intensity_norm, center = TRUE, scale = FALSE)
df_singlechan$modality <- factor(df_singlechan$modality)
df_singlechan$percent_yes_fitted_scaled <- scale(df_singlechan$percent_yes_fitted, center = TRUE, scale = FALSE)
df_singlechan$percent_yes_level <- factor(
df_singlechan$percent_yes_fitted_bin,
levels = c("20-35%", "35-50%", "50-65%", "65-80%"),
ordered = TRUE
)
df_singlechan$percent_yes_level <- as.numeric(df_singlechan$percent_yes_level)
# create linear model
linear_model1_r = glm(amplitude ~ response_decoded, data = df_singlechan)
linear_model1_i = glm(amplitude ~ intensity_norm, data = df_singlechan)
linear_model2 = glm(amplitude ~ intensity_norm + response_decoded, data = df_singlechan)
linear_model3 = glm(amplitude ~ response_decoded + intensity_norm, data = df_singlechan)
linear_model4 = glm(amplitude ~ response_decoded + intensity_c + block, data = df_singlechan)
linear_model5 = glm(amplitude ~ modality + response_decoded + intensity_norm + block, data = df_singlechan)
linear_model4_i = glm(amplitude ~ intensity_norm + response_decoded + block, data = df_singlechan)
linear_model4_r = glm(amplitude ~ response_decoded + intensity_norm + block, data = df_singlechan)
linear_model4_l = glm(amplitude ~ intensity_level + response_decoded + block, data = df_singlechan)
linear_model5 = glm(amplitude ~ response_bin * intensity_c + block, data = df_singlechan)
# create generalized linear mixed model
linear_mixed_model1 = lmer(amplitude ~ response_decoded + intensity_norm + block + (1|sub), data = df_singlechan)
linear_mixed_model2 = lmer(amplitude ~ modality * response_decoded * percent_yes_fitted + (1|sub) + (1|block), data = df_singlechan)
linear_mixed_model3 = lmer(amplitude ~ response_decoded * intensity_c + (1|sub) + (1|block), data = df_singlechan)
linear_mixed_model4 = lmer(amplitude ~ modality + response_decoded * intensity_norm + (1|sub) + (1|block), data = df_singlechan)
# model with force only for mechanical trials
df_mecha <- df_singlechan %>% filter(modality=="Mechanical")
linear_mixed_model3 = lmer(amplitude ~ response_decoded * intensity_norm + force + (1|sub) + (1|block), data = df_mecha)
# create additive model
gam_model1 <- gam(amplitude ~ response_decoded + s(intensity_norm, k = 4),
bs="cr", data = df_singlechan)
gam_model2 <- gam(amplitude ~ response_decoded + s(intensity_norm, k = 4) + block,
bs="cr", data = df_singlechan)
library(lmerTest)
df_mecha <- df_singlechan[modality == "Mechanical"]
df_elec <- df_singlechan[modality == "Electrical"]
df_mecha$sub_scaled <- (as.numeric(df_mecha$sub) - min(as.numeric(df_mecha$sub))) /
(max(as.numeric(df_mecha$sub)) - min(as.numeric(df_mecha$sub)))
df_elec$sub_scaled <- (as.numeric(df_elec$sub) - min(as.numeric(df_elec$sub))) /
(max(as.numeric(df_elec$sub)) - min(as.numeric(df_elec$sub)))
# computing our model and save the results for later TFCE computation
model_mecha <- lmer(amplitude ~ force * response_decoded * percent_yes_level + (1 | sub_scaled) + (1 | block), data = df_mecha, REML=TRUE)
model_elec <- lmer(amplitude ~ response_decoded * percent_yes_level + (1 | sub_scaled) + (1 | block), data = df_elec, REML=TRUE)
# Save model name, formula, t-values, p-values in a list
coef_summary <- as.data.frame(summary(model_mecha)$coefficients)
coef_summary$formula <- paste(deparse(formula(model_mecha)), collapse=" ")
# Save to CSV
write.csv(coef_summary, file = paste0("model_summary_mecha_", channel, "_window_", time_start*1000, ".csv"), row.names = TRUE)
coef_summary
coef_summary <- as.data.frame(summary(model_elec)$coefficients)
coef_summary$formula <- paste(deparse(formula(model_elec)), collapse=" ")
# Save to CSV
write.csv(coef_summary, file = paste0("model_summary_elec_", channel, "_window_", time_start*1000, ".csv"), row.names = TRUE)
coef_summary
# check scaling of predictors
predictor_cols <- sapply(model_elec@frame, is.numeric)
boxplot(model_elec@frame[, predictor_cols], las=2, main="Predictor Scales")
AIC(linear_model1_r,linear_model1_i, linear_model2, linear_model3, linear_model4, linear_model5, linear_model4_i,linear_model4_r, linear_model4_l, linear_mixed_model1, linear_mixed_model2, gam_model1, gam_model2)
# models with the lowest AIC score are prefered
BIC(linear_model1_i, linear_model2, linear_model3, linear_model4, linear_model4_i, linear_model5, linear_mixed_model1, linear_mixed_model2, gam_model1, gam_model2)
# Add predicted values
df_singlechan$fit_lm <- predict(linear_model4)
df_singlechan$fit_glm <- predict(linear_mixed_model1)
df_singlechan$fit_gam <- predict(gam_model2)
# Plot original data + GAM fit
ggplot(df_singlechan, aes(x = intensity_norm, y = amplitude, color = response_decoded)) +
geom_point(alpha = 0.5) +
geom_line(aes(y = fit_lm), size = 1.2) +
labs(title = "GAM fit: Amplitude ~ Response + s(Intensity) + block",
y = "Amplitude", x = "Stimulus Intensity") +
theme_minimal()
vif_values <- vif(linear_model4_l)
vif_values
# Visualizing the model
plot(linear_model5, which = 1, main = "Model Fit")
# Visualizing VIF
barplot(vif_values, col = "skyblue", main = "Variance Inflation Factor (VIF)")
df_singlechan$response_bin <- ifelse(df_singlechan$response_decoded == "Yes", 1, 0)
# check collinearity in GAM
concurvity(gam_model2, full = TRUE)
# Variance inflation for GAM
# extract the values for the predictors
X <- predict(gam_model2, type = "lpmatrix")
## Convert to data frame for car::vif
X_df <- as.data.frame(X)
## Drop the intercept column (if present)
if ("(Intercept)" %in% colnames(X_df)) {
X_df <- X_df[, !(colnames(X_df) == "(Intercept)"), drop = FALSE]
}
## Compute VIFs on the basis functions
# (This can be large if you have many knots — one column per basis function)
vif_basis <- vif(lm(df_singlechan$amplitude ~ ., data = X_df))
## Inspect top VIFs
sort(vif_basis, decreasing = TRUE)
# --> very high VIFs for intensity!!
ggplot(df_singlechan, aes(x = intensity_norm, y = response_bin)) +
geom_jitter(height = 0.05, alpha = 0.3) +
geom_smooth(method = "loess") +
labs(title = "Non-linear relationship check",
x = "Intensity", y = "Response (0/1)") +
theme_minimal()
knitr::opts_chunk$set(echo = TRUE)
library(readr)
library(dplyr)
library(ggplot2)
library(car)         # for VIF
library(broom)       # for tidy model output
library(readr)
library(mgcv)
library(rhdf5)
library(data.table)
library(lme4)
# specify directories
datadir <- Sys.getenv("DATADIR")
resdir <- Sys.getenv("RESDIR")
fig_path <- file.path(resdir, 'Figures', 'Main', 'eeg_results')
behav_dir <- file.path(datadir, "derivatives", "eeg-preproc")
stats_res <- file.path(resdir, "Statistics", "behav")
# subject IDs and file names
subjects <- sprintf("%03d", 13:52)
# Pre-allocate list to store each subject's data
channel = "C6"
#timepoint = 0.054 # in s
time_start <- 0.070   # e.g., 100 ms post-stimulus
time_end <- 0.080     # e.g., 300 ms post-stimulus
# TODO: loop over timepoints and channels (parallelize on HPC)
df_combined_all <- list()
modalities <- c('mecha', 'elec')
# Load each subject and modality
for (mod in modalities) {
for (i in seq_along(subjects)) {
sub_id <- subjects[i]
file_path <- file.path(datadir, "derivatives", "eeg-preproc",
paste0("sub-", sub_id), paste0("ses-", mod),
paste0("sub-", sub_id, "_ses-", mod, "_task-NT_epochs.h5")
)
file_path_meta <- file.path(datadir, "derivatives", "eeg-preproc",
paste0("sub-", sub_id), paste0("ses-", mod),
paste0("sub-", sub_id, "_ses-", mod, "_task-NT_allmetadata.tsv")
)
# Skip iteration if file does not exist
if (!file.exists(file_path)) {
message(paste("No data for subject", sub_id))
next
}
# exclude sub 23 mecha (ground and ref were switched)
if ((mod == 'mecha') & (sub_id == "023")) {
message("Subject 23 Mecha excluded!")
next
}
# Read large file efficiently
df <- h5read(file_path, channel)
#time_idx <- which(df$times == timepoint)
#amplitude <- df$data[time_idx, ]
# extract from timewindow
time_mask <- (df$times >= time_start) & (df$times <= time_end)
if (sum(time_mask) == 0) {
message(paste("No timepoints in window", time_start, "to", time_end, "for", sub_id))
next
}
window_data <- df$data[time_mask, , drop = FALSE]
# Average over time dimension (per trial)
amplitude <- colMeans(window_data)
# read trial metadata and drop bad epochs
df_metadata <- fread(file_path_meta, sep = "\t")
#message(paste0(nrow(df_metadata) , " trials subject ", sub_id, " ", mod))
df_metadata <- df_metadata[drop_epoch==FALSE]
#message(paste0(nrow(df_metadata) , " trials subject ", sub_id, " ", mod))
df_metadata$epoch_index <- seq(0, nrow(df_metadata)-1)
# Convert intensity_level to factor and numeric
df_metadata$intensity_level <- factor(df_metadata$intensity_level)
df_metadata$intensity_num <- as.numeric(df_metadata$intensity_level) -1
df_metadata$response_bin <- ifelse(df_metadata$response_decoded == "Yes", 1, ifelse(df_metadata$response_decoded == "No", 0, NaN))
# extract only relevant columns
desired_cols <- c("sub", "modality", "block", "trialID", "intensity_level", "intensity_norm", "intensity_num", "response_decoded", "response_bin", "force", "analysis_excluded", "plot_excluded", "percent_yes_fitted", "percent_yes_fitted_bin")
df_data <- df_metadata[, desired_cols, with = FALSE]
# add channel amplitude
df_data$amplitude <- amplitude
# collect data in list
df_combined_all[[length(df_combined_all) + 1]] <- df_data
}
}
# Combine all into one big data.table
df_data_all <- rbindlist(df_combined_all)
df_data_all <- as.data.table(df_data_all)
# free up some memory
#rm(list = setdiff(ls(), "df_all_combined"))
#gc()
# Remove none responses and trials that need to be excluded from the analysis based on exclusion criteria
df_all <- df_data_all %>%
mutate(response_decoded = na_if(response_decoded, ""))
df_clean <- df_all %>%
filter(!is.na(response_bin)) %>%
filter(!(analysis_excluded)) #%>%
#filter(!(plot_excluded))
df_clean$response_decoded <- factor(df_clean$response_decoded, levels = c("No", "Yes"))
# check how many trials per condition & subject are in the table
df_clean_mecha <- df_clean %>% filter(modality=='Mechanical')
length(unique(df_clean_mecha$sub))
df_clean_elec <- df_clean %>% filter(modality=='Electrical')
length(unique(df_clean_elec$sub))
stats_summary <- df_clean %>%
group_by(response_decoded, modality) %>%
summarise(
mean_amplitude = mean(amplitude, na.rm = TRUE),
se_amplitude   = sd(amplitude, na.rm = TRUE) / sqrt(n())
)
stats_summary <- stats_summary %>% filter(!is.na(response_decoded))
stats_summary_intensity <- df_clean %>%
group_by(intensity_level, modality) %>%
summarise(
mean_amplitude = mean(amplitude, na.rm = TRUE),
se_amplitude   = sd(amplitude, na.rm = TRUE) / sqrt(n())
)
stats_summary_intensity_mecha <- df_clean %>%
filter(modality=='Mechanical') %>%
group_by(intensity_level, modality) %>%
summarise(
mean_amplitude = mean(amplitude, na.rm = TRUE),
se_amplitude   = sd(amplitude, na.rm = TRUE) / sqrt(n())
)
response_colors <- c("Yes" = "yellow", "No" = "darkblue")
p1 <- ggplot(stats_summary, aes(x = response_decoded, y = mean_amplitude, fill = response_decoded)) +
geom_bar(stat = "identity", position = position_dodge(width = 0.8)) +
geom_errorbar(aes(ymin = mean_amplitude - se_amplitude, ymax = mean_amplitude + se_amplitude),
position = position_dodge(width = 0.8), width = 0.2) +
facet_wrap(~ modality) +  # separates plots by modality
scale_fill_manual(values=response_colors) +
labs(x = "Response Decoded", y = "Mean Amplitude", fill = "Response") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
ggsave(file.path(fig_path, paste0("amplitudeByResponse_", channel, "_timpoint", timepoint*1000, "s.png")), plot=p1)
p2 <- ggplot(stats_summary_intensity, aes(x = intensity_level, y = mean_amplitude, fill = modality)) +
geom_bar(stat = "identity", position = position_dodge(width = 0.8)) +
geom_errorbar(aes(ymin = mean_amplitude - se_amplitude, ymax = mean_amplitude + se_amplitude),
position = position_dodge(width = 0.8), width = 0.2) +
labs(x = "Intensity Level", y = "Mean Amplitude", fill = "Modality") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
ggsave(file.path(fig_path, paste0("amplitudeByIntensity_", channel, "_timpoint", timepoint*1000, "s.png")), plot=p2)
print(p1)
print(p2)
